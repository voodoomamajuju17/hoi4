# 2026-11-10: modelo animado COMUN_acorazado (idle, move, attack)
animation = { name = "COMUN_acorazado_idle_animation" file = "gfx/models/units/COMUN_acorazado/COMUN_acorazado_idle.anim" }
animation = { name = "COMUN_acorazado_move_animation" file = "gfx/models/units/COMUN_acorazado/COMUN_acorazado_move.anim" }
animation = { name = "COMUN_acorazado_attack_animation" file = "gfx/models/units/COMUN_acorazado/COMUN_acorazado_attack.anim" }

pdxmesh = {
    name = "COMUN_acorazado_mesh"
    file = "gfx/models/units/COMUN_acorazado/COMUN_acorazado.mesh"
    animation = { id = "idle" type = "COMUN_acorazado_idle_animation" }
    animation = { id = "move" type = "COMUN_acorazado_move_animation" }
    animation = { id = "attack" type = "COMUN_acorazado_attack_animation" }
  }

entity = {
  name = "COMUN_battleship_entity"
  pdxmesh = "COMUN_acorazado_mesh"
    scale = 1.0
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
