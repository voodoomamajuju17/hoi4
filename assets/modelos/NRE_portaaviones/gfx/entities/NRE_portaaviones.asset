# 2026-11-10: modelo animado NRE_portaaviones (idle, move, attack)
animation = { name = "NRE_portaaviones_idle_animation" file = "gfx/models/units/NRE_portaaviones/NRE_portaaviones_idle.anim" }

animation = { name = "NRE_portaaviones_move_animation" file = "gfx/models/units/NRE_portaaviones/NRE_portaaviones_move.anim" }

animation = { name = "NRE_portaaviones_attack_animation" file = "gfx/models/units/NRE_portaaviones/NRE_portaaviones_attack.anim" }

pdxmesh = {
    name = "NRE_portaaviones_mesh"
    file = "gfx/models/units/NRE_portaaviones/NRE_portaaviones.mesh"
    animation = { id = "idle" type = "NRE_portaaviones_idle_animation" }
    animation = { id = "move" type = "NRE_portaaviones_move_animation" }
    animation = { id = "attack" type = "NRE_portaaviones_attack_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_carrier_entity"
    pdxmesh = "NRE_portaaviones_mesh"
    scale = 0.994
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.15 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.15 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.15 }
}
