# 2026-11-10: modelo animado APF_submarino (idle, move, attack)
animation = {
    name = "APF_submarino_idle_anim"
    file = "gfx/models/units/APF_submarino/APF_submarino_idle.anim"
}

animation = {
    name = "APF_submarino_move_anim"
    file = "gfx/models/units/APF_submarino/APF_submarino_move.anim"
}

animation = {
    name = "APF_submarino_attack_anim"
    file = "gfx/models/units/APF_submarino/APF_submarino_attack.anim"
}

animation = {
    name = "APF_submarino_dive_anim"
    file = "gfx/models/units/APF_submarino/APF_submarino_dive.anim"
}

pdxmesh = {
    name = "APF_submarino_mesh"
    file = "gfx/models/units/APF_submarino/APF_submarino.mesh"
    scale = 1.0
    animation = { id = "idle" type = "APF_submarino_idle_anim" }
    animation = { id = "move" type = "APF_submarino_move_anim" }
    animation = { id = "attack" type = "APF_submarino_attack_anim" }
    animation = { id = "dive" type = "APF_submarino_dive_anim" }
    }

entity = {
    name = "APF_submarine_entity"
    pdxmesh = "APF_submarino_mesh"
    scale = 0.953
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 0.1 looping = yes }
    state = { name = "move" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "dive" animation = "dive" animation_blend_time = 0.1 looping = no next_state = "idle" }
    state = { name = "retreat" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "defend" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "support_attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "training" animation = "idle" animation_blend_time = 0.1 looping = yes }
}
