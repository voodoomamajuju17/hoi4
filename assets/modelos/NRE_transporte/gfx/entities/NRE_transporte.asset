# 2026-11-10: modelo animado NRE_transporte (idle, move, attack)
animation = { name = "NRE_transporte_idle_animation" file = "gfx/models/units/NRE_transporte/NRE_transporte_idle.anim" }

animation = { name = "NRE_transporte_move_animation" file = "gfx/models/units/NRE_transporte/NRE_transporte_move.anim" }

animation = { name = "NRE_transporte_attack_animation" file = "gfx/models/units/NRE_transporte/NRE_transporte_attack.anim" }

pdxmesh = {
    name = "NRE_transporte_mesh"
    file = "gfx/models/units/NRE_transporte/NRE_transporte.mesh"
    animation = { id = "idle" type = "NRE_transporte_idle_animation" }
    animation = { id = "move" type = "NRE_transporte_move_animation" }
    animation = { id = "attack" type = "NRE_transporte_attack_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_convoy_entity"
    pdxmesh = "NRE_transporte_mesh"
    scale = 0.809
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.15 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.15 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.15 }
}
