# 2026-11-10: modelo animado FCU_destructor (idle, move, attack)
animation = { name = "FCU_destructor_idle_animation" file = "gfx/models/units/FCU_destructor/FCU_destructor_idle.anim" }
animation = { name = "FCU_destructor_move_animation" file = "gfx/models/units/FCU_destructor/FCU_destructor_move.anim" }
animation = { name = "FCU_destructor_attack_animation" file = "gfx/models/units/FCU_destructor/FCU_destructor_attack.anim" }

pdxmesh = {
    name = "FCU_destructor_mesh"
    file = "gfx/models/units/FCU_destructor/FCU_destructor.mesh"
    animation = { id = "idle" type = "FCU_destructor_idle_animation" }
    animation = { id = "move" type = "FCU_destructor_move_animation" }
    animation = { id = "attack" type = "FCU_destructor_attack_animation" }
  }

entity = {
  name = "FCU_destroyer_entity"
  pdxmesh = "FCU_destructor_mesh"
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "moving" animation = "move" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
}
