# 2026-11-10: modelo animado NRE_infanteria (idle, move, attack)
animation = { name = "NRE_infanteria_idle_animation" file = "gfx/models/units/NRE_infanteria/NRE_infanteria_idle.anim" }

animation = { name = "NRE_infanteria_move_animation" file = "gfx/models/units/NRE_infanteria/NRE_infanteria_move.anim" }

animation = { name = "NRE_infanteria_attack_animation" file = "gfx/models/units/NRE_infanteria/NRE_infanteria_attack.anim" }

animation = { name = "NRE_infanteria_die_animation" file = "gfx/models/units/NRE_infanteria/NRE_infanteria_die.anim" }

pdxmesh = {
    name = "NRE_infanteria_mesh"
    file = "gfx/models/units/NRE_infanteria/NRE_infanteria.mesh"
    animation = { id = "idle" type = "NRE_infanteria_idle_animation" }
    animation = { id = "move" type = "NRE_infanteria_move_animation" }
    animation = { id = "attack" type = "NRE_infanteria_attack_animation" }
    animation = { id = "die" type = "NRE_infanteria_die_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_infantry_entity"
    pdxmesh = "NRE_infanteria_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.12 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.12 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.12 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.12 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.12 }
    state = { name = "support_attack" animation = "attack" looping = yes animation_blend_time = 0.12 }
    state = { name = "training" animation = "move" looping = yes animation_blend_time = 0.12 }
    state = { name = "death" animation = "die" looping = no animation_blend_time = 0.12 }
}
