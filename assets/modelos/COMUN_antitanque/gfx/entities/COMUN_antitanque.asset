animation = { name = "COMUN_antitanque_idle_animation" file = "gfx/models/units/COMUN_antitanque/COMUN_antitanque_idle.anim" }
animation = { name = "COMUN_antitanque_move_animation" file = "gfx/models/units/COMUN_antitanque/COMUN_antitanque_move.anim" }
animation = { name = "COMUN_antitanque_attack_animation" file = "gfx/models/units/COMUN_antitanque/COMUN_antitanque_attack.anim" }

pdxmesh = {
    name = "COMUN_antitanque_mesh"
