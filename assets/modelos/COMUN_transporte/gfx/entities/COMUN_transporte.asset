# 2026-11-10: modelo animado COMUN_transporte (idle, move, attack)
animation = { name = "COMUN_transporte_idle_animation" file = "gfx/models/units/COMUN_transporte/COMUN_transporte_idle.anim" }
animation = { name = "COMUN_transporte_move_animation" file = "gfx/models/units/COMUN_transporte/COMUN_transporte_move.anim" }
animation = { name = "COMUN_transporte_attack_animation" file = "gfx/models/units/COMUN_transporte/COMUN_transporte_attack.anim" }

pdxmesh = {
    name = "COMUN_transporte_mesh"
    file = "gfx/models/units/COMUN_transporte/COMUN_transporte.mesh"
    animation = { id = "idle" type = "COMUN_transporte_idle_animation" }
    animation = { id = "move" type = "COMUN_transporte_move_animation" }
    animation = { id = "attack" type = "COMUN_transporte_attack_animation" }
  }

entity = {
  name = "COMUN_convoy_entity"
  pdxmesh = "COMUN_transporte_mesh"
    scale = 1.0
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
