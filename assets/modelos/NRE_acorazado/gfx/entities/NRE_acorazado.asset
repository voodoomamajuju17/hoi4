# 2026-11-10: modelo animado NRE_acorazado (idle, move, attack)
animation = { name = "NRE_acorazado_idle_animation" file = "gfx/models/units/NRE_acorazado/NRE_acorazado_idle.anim" }

animation = { name = "NRE_acorazado_move_animation" file = "gfx/models/units/NRE_acorazado/NRE_acorazado_move.anim" }

animation = { name = "NRE_acorazado_attack_animation" file = "gfx/models/units/NRE_acorazado/NRE_acorazado_attack.anim" }

pdxmesh = {
    name = "NRE_acorazado_mesh"
    file = "gfx/models/units/NRE_acorazado/NRE_acorazado.mesh"
    animation = { id = "idle" type = "NRE_acorazado_idle_animation" }
    animation = { id = "move" type = "NRE_acorazado_move_animation" }
    animation = { id = "attack" type = "NRE_acorazado_attack_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_battleship_entity"
    pdxmesh = "NRE_acorazado_mesh"
    scale = 1.002
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.15 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.15 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.15 }
}
