# 2026-11-10: modelo animado NRE_destructor (idle, move, attack)
animation = { name = "NRE_destructor_idle_animation" file = "gfx/models/units/NRE_destructor/NRE_destructor_idle.anim" }

animation = { name = "NRE_destructor_move_animation" file = "gfx/models/units/NRE_destructor/NRE_destructor_move.anim" }

animation = { name = "NRE_destructor_attack_animation" file = "gfx/models/units/NRE_destructor/NRE_destructor_attack.anim" }

pdxmesh = {
    name = "NRE_destructor_mesh"
    file = "gfx/models/units/NRE_destructor/NRE_destructor.mesh"
    animation = { id = "idle" type = "NRE_destructor_idle_animation" }
    animation = { id = "move" type = "NRE_destructor_move_animation" }
    animation = { id = "attack" type = "NRE_destructor_attack_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_destroyer_entity"
    pdxmesh = "NRE_destructor_mesh"
    scale = 0.849
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.15 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.15 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.15 }
}
