# 2026-11-10: modelo animado APF_transporte (idle, move, attack)
animation = {
    name = "APF_transporte_idle_anim"
    file = "gfx/models/units/APF_transporte/APF_transporte_idle.anim"
}

animation = {
    name = "APF_transporte_move_anim"
    file = "gfx/models/units/APF_transporte/APF_transporte_move.anim"
}

animation = {
    name = "APF_transporte_attack_anim"
    file = "gfx/models/units/APF_transporte/APF_transporte_attack.anim"
}

animation = {
    name = "APF_transporte_cargo_anim"
    file = "gfx/models/units/APF_transporte/APF_transporte_cargo.anim"
}

pdxmesh = {
    name = "APF_transporte_mesh"
    file = "gfx/models/units/APF_transporte/APF_transporte.mesh"
    scale = 1.0
    animation = { id = "idle" type = "APF_transporte_idle_anim" }
    animation = { id = "move" type = "APF_transporte_move_anim" }
    animation = { id = "attack" type = "APF_transporte_attack_anim" }
    animation = { id = "cargo" type = "APF_transporte_cargo_anim" }
    }

entity = {
    name = "APF_convoy_entity"
    pdxmesh = "APF_transporte_mesh"
    scale = 0.75
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 0.1 looping = yes }
    state = { name = "move" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "cargo" animation = "cargo" animation_blend_time = 0.1 looping = no next_state = "idle" }
    state = { name = "retreat" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "defend" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "support_attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "training" animation = "idle" animation_blend_time = 0.1 looping = yes }
}
