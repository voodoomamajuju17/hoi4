# 2026-11-21: modelo animado ASC_blindado_ligero nuevo (idle, move, attack, 24 fps; ASC_terrestres_completo.zip)
animation = {
    name = "ASC_blindado_ligero_idle_animation"
    file = "gfx/models/units/ASC_blindado_ligero/ASC_blindado_ligero_idle.anim"
}

animation = {
    name = "ASC_blindado_ligero_move_animation"
    file = "gfx/models/units/ASC_blindado_ligero/ASC_blindado_ligero_move.anim"
}

animation = {
    name = "ASC_blindado_ligero_attack_animation"
    file = "gfx/models/units/ASC_blindado_ligero/ASC_blindado_ligero_attack.anim"
}

pdxmesh = {
    name = "ASC_blindado_ligero_mesh"
    file = "gfx/models/units/ASC_blindado_ligero/ASC_blindado_ligero.mesh"
    scale = 1.0
    animation = { id = "idle" type = "ASC_blindado_ligero_idle_animation" }
    animation = { id = "move" type = "ASC_blindado_ligero_move_animation" }
    animation = { id = "attack" type = "ASC_blindado_ligero_attack_animation" }
    }

entity = {
    name = "ASC_armored_car_entity"
    pdxmesh = "ASC_blindado_ligero_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.05 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.05 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "support_attack" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.05 }
    state = { name = "training" animation = "move" looping = yes animation_blend_time = 0.05 }
}
