# 2026-11-10: modelo animado NRE_caza (idle, move, attack)
animation = { name = "NRE_caza_idle_animation" file = "gfx/models/units/NRE_caza/NRE_caza_idle.anim" }

animation = { name = "NRE_caza_move_animation" file = "gfx/models/units/NRE_caza/NRE_caza_move.anim" }

animation = { name = "NRE_caza_attack_animation" file = "gfx/models/units/NRE_caza/NRE_caza_attack.anim" }

pdxmesh = {
    name = "NRE_caza_mesh"
    file = "gfx/models/units/NRE_caza/NRE_caza.mesh"
    animation = { id = "idle" type = "NRE_caza_idle_animation" }
    animation = { id = "move" type = "NRE_caza_move_animation" }
    animation = { id = "attack" type = "NRE_caza_attack_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_fighter_entity"
    pdxmesh = "NRE_caza_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.12 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.12 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.12 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.12 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.12 }
    state = { name = "support_attack" animation = "attack" looping = yes animation_blend_time = 0.12 }
    state = { name = "training" animation = "move" looping = yes animation_blend_time = 0.12 }
}
