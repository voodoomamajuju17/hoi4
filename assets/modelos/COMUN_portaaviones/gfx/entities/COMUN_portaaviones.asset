# 2026-11-10: modelo animado COMUN_portaaviones (idle, move, attack)
animation = { name = "COMUN_portaaviones_idle_animation" file = "gfx/models/units/COMUN_portaaviones/COMUN_portaaviones_idle.anim" }
animation = { name = "COMUN_portaaviones_move_animation" file = "gfx/models/units/COMUN_portaaviones/COMUN_portaaviones_move.anim" }
animation = { name = "COMUN_portaaviones_attack_animation" file = "gfx/models/units/COMUN_portaaviones/COMUN_portaaviones_attack.anim" }

pdxmesh = {
    name = "COMUN_portaaviones_mesh"
    file = "gfx/models/units/COMUN_portaaviones/COMUN_portaaviones.mesh"
    animation = { id = "idle" type = "COMUN_portaaviones_idle_animation" }
    animation = { id = "move" type = "COMUN_portaaviones_move_animation" }
    animation = { id = "attack" type = "COMUN_portaaviones_attack_animation" }
  }

entity = {
  name = "COMUN_carrier_entity"
  pdxmesh = "COMUN_portaaviones_mesh"
    scale = 1.0
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
