# 2026-11-20: modelo animado ZRD_movil (attack, idle, move), de La Red
animation = {
    name = "ZRD_movil_attack_animation"
    file = "gfx/models/units/ZRD_movil/ZRD_movil_attack.anim"
}

animation = {
    name = "ZRD_movil_idle_animation"
    file = "gfx/models/units/ZRD_movil/ZRD_movil_idle.anim"
}

animation = {
    name = "ZRD_movil_move_animation"
    file = "gfx/models/units/ZRD_movil/ZRD_movil_move.anim"
}

pdxmesh = {
    name = "ZRD_movil_mesh"
    file = "gfx/models/units/ZRD_movil/ZRD_movil.mesh"
    scale = 1.0
    animation = { id = "attack" type = "ZRD_movil_attack_animation" }
    animation = { id = "idle" type = "ZRD_movil_idle_animation" }
    animation = { id = "move" type = "ZRD_movil_move_animation" }
}

entity = {
    name = "ZRD_cavalry_entity"
    pdxmesh = "ZRD_movil_mesh"
    default_state = "idle"
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.05 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.05 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "support_attack" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.05 }
    state = { name = "training" animation = "move" looping = yes animation_blend_time = 0.05 }
}
