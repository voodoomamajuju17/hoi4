# 2026-11-10: modelo animado COMUN_mecanizada (idle, move, attack)
animation = { name = "COMUN_mecanizada_idle_animation" file = "gfx/models/units/COMUN_mecanizada/COMUN_mecanizada_idle.anim" }
animation = { name = "COMUN_mecanizada_move_animation" file = "gfx/models/units/COMUN_mecanizada/COMUN_mecanizada_move.anim" }
animation = { name = "COMUN_mecanizada_attack_animation" file = "gfx/models/units/COMUN_mecanizada/COMUN_mecanizada_attack.anim" }

pdxmesh = {
    name = "COMUN_mecanizada_mesh"
    file = "gfx/models/units/COMUN_mecanizada/COMUN_mecanizada.mesh"
    animation = { id = "idle" type = "COMUN_mecanizada_idle_animation" }
    animation = { id = "move" type = "COMUN_mecanizada_move_animation" }
    animation = { id = "attack" type = "COMUN_mecanizada_attack_animation" }
  }

entity = {
  name = "COMUN_mechanized_entity"
  pdxmesh = "COMUN_mecanizada_mesh"
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
