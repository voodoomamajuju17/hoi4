# 2026-11-10: modelo animado ZJP_mecha (idle, move, attack)
animation = {
    name = "ZJP_mecha_idle_animation"
    file = "gfx/models/units/ZJP_mecha/ZJP_mecha_idle.anim"
}

animation = {
    name = "ZJP_mecha_move_animation"
    file = "gfx/models/units/ZJP_mecha/ZJP_mecha_move.anim"
}

animation = {
    name = "ZJP_mecha_attack_animation"
    file = "gfx/models/units/ZJP_mecha/ZJP_mecha_attack.anim"
}

pdxmesh = {
    name = "ZJP_mecha_mesh"
    file = "gfx/models/units/ZJP_mecha/ZJP_mecha.mesh"
    scale = 1.0
    animation = { id = "idle" type = "ZJP_mecha_idle_animation" }
    animation = { id = "move" type = "ZJP_mecha_move_animation" }
    animation = { id = "attack" type = "ZJP_mecha_attack_animation" }
    }

entity = {
    name = "ZJP_mecha_entity"
    pdxmesh = "ZJP_mecha_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "move" animation = "move" looping = yes }
    state = { name = "attack" animation = "attack" looping = yes }
}
entity = {
    name = "ZJP_heavy_armor_entity"
    pdxmesh = "ZJP_mecha_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "move" animation = "move" looping = yes }
    state = { name = "attack" animation = "attack" looping = yes }
}
