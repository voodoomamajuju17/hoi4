# 2026-11-10: modelo animado FCU_movil (idle, move, attack)
animation = { name = "FCU_movil_idle_animation" file = "gfx/models/units/FCU_movil/FCU_movil_idle.anim" }
animation = { name = "FCU_movil_move_animation" file = "gfx/models/units/FCU_movil/FCU_movil_move.anim" }
animation = { name = "FCU_movil_attack_animation" file = "gfx/models/units/FCU_movil/FCU_movil_attack.anim" }

pdxmesh = {
    name = "FCU_movil_mesh"
    file = "gfx/models/units/FCU_movil/FCU_movil.mesh"
    animation = { id = "idle" type = "FCU_movil_idle_animation" }
    animation = { id = "move" type = "FCU_movil_move_animation" }
    animation = { id = "attack" type = "FCU_movil_attack_animation" }
  }

entity = {
  name = "FCU_cavalry_entity"
  pdxmesh = "FCU_movil_mesh"
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
