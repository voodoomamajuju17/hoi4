# 2026-11-10: modelo animado ASC_montana (idle, move, attack)
animation = {
    name = "ASC_montana_idle_animation"
    file = "gfx/models/units/ASC_montana/ASC_montana_idle.anim"
}

animation = {
    name = "ASC_montana_move_animation"
    file = "gfx/models/units/ASC_montana/ASC_montana_move.anim"
}

animation = {
    name = "ASC_montana_attack_animation"
    file = "gfx/models/units/ASC_montana/ASC_montana_attack.anim"
}

animation = {
    name = "ASC_montana_die_animation"
    file = "gfx/models/units/ASC_montana/ASC_montana_die.anim"
}

pdxmesh = {
    name = "ASC_montana"
    file = "gfx/models/units/ASC_montana/ASC_montana.mesh"
    scale = 1.0
    animation = { id = "idle" type = "ASC_montana_idle_animation" }
    animation = { id = "move" type = "ASC_montana_move_animation" }
    animation = { id = "attack" type = "ASC_montana_attack_animation" }
    animation = { id = "die" type = "ASC_montana_die_animation" }
    }

entity = {
    name = "ASC_mountaineers_entity"
    pdxmesh = "ASC_montana"
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 0.15 looping = yes }
    state = { name = "move" animation = "move" animation_blend_time = 0.15 looping = yes }
    state = { name = "attack" animation = "attack" animation_blend_time = 0.15 looping = yes }
    state = { name = "die" animation = "die" animation_blend_time = 0.10 looping = no }
    state = { name = "defend" animation = "attack" animation_blend_time = 0.15 looping = yes }
    state = { name = "death" animation = "die" looping = no }
    state = { name = "retreat" animation = "move" looping = yes }
    state = { name = "support_attack" animation = "attack" looping = yes }
}
