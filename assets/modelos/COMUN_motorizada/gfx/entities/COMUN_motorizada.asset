# 2026-11-10: modelo animado COMUN_motorizada (idle, move, attack)
animation = { name = "COMUN_motorizada_idle_animation" file = "gfx/models/units/COMUN_motorizada/COMUN_motorizada_idle.anim" }
animation = { name = "COMUN_motorizada_move_animation" file = "gfx/models/units/COMUN_motorizada/COMUN_motorizada_move.anim" }
animation = { name = "COMUN_motorizada_attack_animation" file = "gfx/models/units/COMUN_motorizada/COMUN_motorizada_attack.anim" }

pdxmesh = {
    name = "COMUN_motorizada_mesh"
    file = "gfx/models/units/COMUN_motorizada/COMUN_motorizada.mesh"
    animation = { id = "idle" type = "COMUN_motorizada_idle_animation" }
    animation = { id = "move" type = "COMUN_motorizada_move_animation" }
    animation = { id = "attack" type = "COMUN_motorizada_attack_animation" }
  }

entity = {
  name = "COMUN_motorized_entity"
  pdxmesh = "COMUN_motorizada_mesh"
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
