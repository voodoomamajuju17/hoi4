# 2026-11-10: modelo animado ZJP_movil (idle, move, attack)
animation = {
    name = "ZJP_movil_idle_animation"
    file = "gfx/models/units/ZJP_movil/ZJP_movil_idle.anim"
}

animation = {
    name = "ZJP_movil_move_animation"
    file = "gfx/models/units/ZJP_movil/ZJP_movil_move.anim"
}

animation = {
    name = "ZJP_movil_attack_animation"
    file = "gfx/models/units/ZJP_movil/ZJP_movil_attack.anim"
}

pdxmesh = {
    name = "ZJP_movil_mesh"
    file = "gfx/models/units/ZJP_movil/ZJP_movil.mesh"
    scale = 1.0
    animation = { id = "idle" type = "ZJP_movil_idle_animation" }
    animation = { id = "move" type = "ZJP_movil_move_animation" }
    animation = { id = "attack" type = "ZJP_movil_attack_animation" }
    }

entity = {
    name = "ZJP_cavalry_entity"
    pdxmesh = "ZJP_movil_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "move" animation = "move" looping = yes }
    state = { name = "attack" animation = "attack" looping = yes }
}
