# 2026-11-10: modelo animado ZAL_movil (idle, move, attack)
animation = {
    name = "ZAL_movil_idle_animation"
    file = "gfx/models/units/ZAL_movil/ZAL_movil_idle.anim"
}

animation = {
    name = "ZAL_movil_move_animation"
    file = "gfx/models/units/ZAL_movil/ZAL_movil_move.anim"
}

animation = {
    name = "ZAL_movil_attack_animation"
    file = "gfx/models/units/ZAL_movil/ZAL_movil_attack.anim"
}

pdxmesh = {
    name = "ZAL_movil_mesh"
    file = "gfx/models/units/ZAL_movil/ZAL_movil.mesh"
    scale = 1.0
    animation = { id = "idle" type = "ZAL_movil_idle_animation" }
    animation = { id = "move" type = "ZAL_movil_move_animation" }
    animation = { id = "attack" type = "ZAL_movil_attack_animation" }
    }

entity = {
    name = "ZAL_cavalry_entity"
    pdxmesh = "ZAL_movil_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "move" animation = "move" looping = yes }
    state = { name = "attack" animation = "attack" looping = yes }
}
