# 2026-11-10: modelo animado APF_kiboko (idle, move, attack)
animation = {
    name = "APF_kiboko_idle_anim"
    file = "gfx/models/units/APF_kiboko/APF_kiboko_idle.anim"
}

animation = {
    name = "APF_kiboko_move_anim"
    file = "gfx/models/units/APF_kiboko/APF_kiboko_move.anim"
}

animation = {
    name = "APF_kiboko_attack_anim"
    file = "gfx/models/units/APF_kiboko/APF_kiboko_attack.anim"
}

animation = {
    name = "APF_kiboko_swim_anim"
    file = "gfx/models/units/APF_kiboko/APF_kiboko_swim.anim"
}

pdxmesh = {
    name = "APF_kiboko_mesh"
    file = "gfx/models/units/APF_kiboko/APF_kiboko.mesh"
    scale = 1.0
    animation = { id = "idle" type = "APF_kiboko_idle_anim" }
    animation = { id = "move" type = "APF_kiboko_move_anim" }
    animation = { id = "attack" type = "APF_kiboko_attack_anim" }
    animation = { id = "swim" type = "APF_kiboko_swim_anim" }
    }

entity = {
    name = "APF_kiboko_entity"
    pdxmesh = "APF_kiboko_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 0.1 looping = yes }
    state = { name = "move" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "swim" animation = "swim" animation_blend_time = 0.1 looping = yes }
    state = { name = "retreat" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "defend" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "support_attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "training" animation = "idle" animation_blend_time = 0.1 looping = yes }
}
