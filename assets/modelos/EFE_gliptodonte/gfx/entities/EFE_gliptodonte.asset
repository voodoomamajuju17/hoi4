# 2026-11-10: modelo animado EFE_gliptodonte (idle, move, attack)
animation = {
    name = "EFE_gliptodonte_idle_animation"
    file = "gfx/models/units/EFE_gliptodonte/EFE_gliptodonte_idle.anim"
}

animation = {
    name = "EFE_gliptodonte_move_animation"
    file = "gfx/models/units/EFE_gliptodonte/EFE_gliptodonte_move.anim"
}

animation = {
    name = "EFE_gliptodonte_attack_animation"
    file = "gfx/models/units/EFE_gliptodonte/EFE_gliptodonte_attack.anim"
}

pdxmesh = {
    name = "EFE_gliptodonte_mesh"
    file = "gfx/models/units/EFE_gliptodonte/EFE_gliptodonte.mesh"
    scale = 1.0
    animation = { id = "idle" type = "EFE_gliptodonte_idle_animation" }
    animation = { id = "move" type = "EFE_gliptodonte_move_animation" }
    animation = { id = "attack" type = "EFE_gliptodonte_attack_animation" }
    }

entity = {
    name = "EFE_gliptodonte_entity"
    pdxmesh = "EFE_gliptodonte_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "move" animation = "move" looping = yes }
    state = { name = "attack" animation = "attack" looping = yes }
}
