# 2026-11-10: modelo animado COMUN_submarino (idle, move, attack)
animation = { name = "COMUN_submarino_idle_animation" file = "gfx/models/units/COMUN_submarino/COMUN_submarino_idle.anim" }
animation = { name = "COMUN_submarino_move_animation" file = "gfx/models/units/COMUN_submarino/COMUN_submarino_move.anim" }
animation = { name = "COMUN_submarino_attack_animation" file = "gfx/models/units/COMUN_submarino/COMUN_submarino_attack.anim" }

pdxmesh = {
    name = "COMUN_submarino_mesh"
    file = "gfx/models/units/COMUN_submarino/COMUN_submarino.mesh"
    animation = { id = "idle" type = "COMUN_submarino_idle_animation" }
    animation = { id = "move" type = "COMUN_submarino_move_animation" }
    animation = { id = "attack" type = "COMUN_submarino_attack_animation" }
  }

entity = {
  name = "COMUN_submarine_entity"
  pdxmesh = "COMUN_submarino_mesh"
    scale = 1.0
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
}
