# 2026-11-10: modelo animado APF_destructor (idle, move, attack)
animation = {
    name = "APF_destructor_idle_anim"
    file = "gfx/models/units/APF_destructor/APF_destructor_idle.anim"
}

animation = {
    name = "APF_destructor_move_anim"
    file = "gfx/models/units/APF_destructor/APF_destructor_move.anim"
}

animation = {
    name = "APF_destructor_attack_anim"
    file = "gfx/models/units/APF_destructor/APF_destructor_attack.anim"
}

pdxmesh = {
    name = "APF_destructor_mesh"
    file = "gfx/models/units/APF_destructor/APF_destructor.mesh"
    scale = 1.0
    animation = { id = "idle" type = "APF_destructor_idle_anim" }
    animation = { id = "move" type = "APF_destructor_move_anim" }
    animation = { id = "attack" type = "APF_destructor_attack_anim" }
    }

entity = {
    name = "APF_destroyer_entity"
    pdxmesh = "APF_destructor_mesh"
    scale = 0.806
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 0.1 looping = yes }
    state = { name = "move" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "defend" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "retreat" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "support_attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "training" animation = "idle" animation_blend_time = 0.1 looping = yes }
}
