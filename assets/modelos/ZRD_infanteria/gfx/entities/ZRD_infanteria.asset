pdxmesh = {
    name = "ZRD_infanteria_mesh"
    file = "gfx/models/units/ZRD_infanteria/ZRD_infanteria.mesh"
    scale = 1.0
    animation = { id = "attack" type = "ZRD_infanteria_attack_animation" }
    animation = { id = "die" type = "ZRD_infanteria_die_animation" }
    animation = { id = "idle" type = "ZRD_infanteria_idle_animation" }
