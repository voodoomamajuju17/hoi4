# 2026-11-21: modelo animado ZRD_caza (attack, idle, move)
animation = {
    name = "ZRD_caza_attack_animation"
    file = "gfx/models/units/ZRD_caza/ZRD_caza_attack.anim"
}

animation = {
    name = "ZRD_caza_idle_animation"
    file = "gfx/models/units/ZRD_caza/ZRD_caza_idle.anim"
}

animation = {
    name = "ZRD_caza_move_animation"
    file = "gfx/models/units/ZRD_caza/ZRD_caza_move.anim"
}

pdxmesh = {
    name = "ZRD_caza_mesh"
    file = "gfx/models/units/ZRD_caza/ZRD_caza.mesh"
    scale = 1.0
    animation = { id = "idle" type = "ZRD_caza_idle_animation" }
    animation = { id = "move" type = "ZRD_caza_move_animation" }
    animation = { id = "attack" type = "ZRD_caza_attack_animation" }
}

entity = {
    name = "ZRD_fighter_entity"
    pdxmesh = "ZRD_caza_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.05 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.05 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "support_attack" animation = "attack" looping = yes animation_blend_time = 0.05 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.05 }
    state = { name = "training" animation = "move" looping = yes animation_blend_time = 0.05 }
}
