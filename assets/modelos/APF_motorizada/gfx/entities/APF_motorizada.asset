# 2026-11-10: modelo animado APF_motorizada (idle, move, attack)
animation = {
    name = "APF_motorizada_idle_anim"
    file = "gfx/models/units/APF_motorizada/APF_motorizada_idle.anim"
}

animation = {
    name = "APF_motorizada_move_anim"
    file = "gfx/models/units/APF_motorizada/APF_motorizada_move.anim"
}

animation = {
    name = "APF_motorizada_attack_anim"
    file = "gfx/models/units/APF_motorizada/APF_motorizada_attack.anim"
}

pdxmesh = {
    name = "APF_motorizada_mesh"
    file = "gfx/models/units/APF_motorizada/APF_motorizada.mesh"
    scale = 1.0
    animation = { id = "idle" type = "APF_motorizada_idle_anim" }
    animation = { id = "move" type = "APF_motorizada_move_anim" }
    animation = { id = "attack" type = "APF_motorizada_attack_anim" }
    }

entity = {
    name = "APF_motorized_entity"
    pdxmesh = "APF_motorizada_mesh"
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 0.1 looping = yes }
    state = { name = "move" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "defend" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "support_attack" animation = "attack" animation_blend_time = 0.1 looping = yes }
    state = { name = "retreat" animation = "move" animation_blend_time = 0.1 looping = yes }
    state = { name = "training" animation = "idle" animation_blend_time = 0.1 looping = yes }
}
