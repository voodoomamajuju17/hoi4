# 2026-11-10: modelo animado FCU_portaaviones (idle, move, attack)
animation = { name = "FCU_portaaviones_idle_animation" file = "gfx/models/units/FCU_portaaviones/FCU_portaaviones_idle.anim" }
animation = { name = "FCU_portaaviones_move_animation" file = "gfx/models/units/FCU_portaaviones/FCU_portaaviones_move.anim" }
animation = { name = "FCU_portaaviones_attack_animation" file = "gfx/models/units/FCU_portaaviones/FCU_portaaviones_attack.anim" }

pdxmesh = {
    name = "FCU_portaaviones_mesh"
    file = "gfx/models/units/FCU_portaaviones/FCU_portaaviones.mesh"
    animation = { id = "idle" type = "FCU_portaaviones_idle_animation" }
    animation = { id = "move" type = "FCU_portaaviones_move_animation" }
    animation = { id = "attack" type = "FCU_portaaviones_attack_animation" }
  }

entity = {
  name = "FCU_carrier_entity"
  pdxmesh = "FCU_portaaviones_mesh"
  default_state = "idle"
  state = { name = "idle" animation = "idle" looping = yes }
  state = { name = "move" animation = "move" looping = yes }
  state = { name = "attack" animation = "attack" looping = yes }
  state = { name = "moving" animation = "move" looping = yes }
  state = { name = "retreat" animation = "move" looping = yes }
  state = { name = "training" animation = "idle" looping = yes }
  state = { name = "defend" animation = "attack" looping = yes }
  state = { name = "support_attack" animation = "attack" looping = yes }
}
