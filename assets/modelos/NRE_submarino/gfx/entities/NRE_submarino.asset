# 2026-11-10: modelo animado NRE_submarino (idle, move, attack)
animation = { name = "NRE_submarino_idle_animation" file = "gfx/models/units/NRE_submarino/NRE_submarino_idle.anim" }

animation = { name = "NRE_submarino_move_animation" file = "gfx/models/units/NRE_submarino/NRE_submarino_move.anim" }

animation = { name = "NRE_submarino_attack_animation" file = "gfx/models/units/NRE_submarino/NRE_submarino_attack.anim" }

pdxmesh = {
    name = "NRE_submarino_mesh"
    file = "gfx/models/units/NRE_submarino/NRE_submarino.mesh"
    animation = { id = "idle" type = "NRE_submarino_idle_animation" }
    animation = { id = "move" type = "NRE_submarino_move_animation" }
    animation = { id = "attack" type = "NRE_submarino_attack_animation" }
    scale = 1.0
    }

entity = {
    name = "NRE_submarine_entity"
    pdxmesh = "NRE_submarino_mesh"
    scale = 0.865
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes animation_blend_time = 0.15 }
    state = { name = "move" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "attack" animation = "attack" looping = yes animation_blend_time = 0.15 }
    state = { name = "retreat" animation = "move" looping = yes animation_blend_time = 0.15 }
    state = { name = "defend" animation = "attack" looping = yes animation_blend_time = 0.15 }
}
